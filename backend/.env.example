SECRET_KEY=change-me-in-production
DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5177
# PostgreSQL. Default: postgres:///<repo folder name, - as _> on the local socket (dev.sh creates it).
# DATABASE_URL=postgres://user:password@localhost:5432/myapp

# Open sign-up. Defaults to True in dev and False in production (production.py).
# ALLOW_REGISTRATION=True

# Site-wide login (default True). False lets anonymous visitors read pages and API views
# marked public; everything else still needs a login.
# REQUIRE_LOGIN=False

# Django admin path (default django-admin/). Staff sign in to it with a passkey.
# ADMIN_URL=django-admin/

# Passkeys: name shown by the browser, and an optional fixed relying party ID
# (default: the hostname the app is opened on).
# PASSKEY_RP_NAME=App
# PASSKEY_RP_ID=example.com

# Optional: Fernet key used to encrypt user-provided secrets at rest.
# When unset, apps/users/crypto.py falls back to keychain.key, then derives a
# key from SECRET_KEY. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SETTINGS_ENCRYPTION_KEY=
