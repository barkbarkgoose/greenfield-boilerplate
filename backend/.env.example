SECRET_KEY=change-me-in-production
DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5177
DATABASE_URL=sqlite:///db.sqlite3

# Django admin path; unset = random per server start (see README).
# ADMIN_URL=back-office-change-me/

# Passkeys: per-user requirement (User.passkey_required). False ignores it everywhere.
# PASSKEYS_ENABLED=True

# --- Dirt & topsoil delivery --------------------------------------------------
# Public frontend URL used in email links.
# SITE_URL=https://example.com
# Comma-separated addresses that get "new request" / "customer replied" emails.
# INTAKE_NOTIFY_EMAILS=you@example.com
# BUSINESS_NAME="Groundwork Soil & Supply"
# DEFAULT_FROM_EMAIL="Groundwork Soil & Supply <orders@example.com>"
# SMTP (put EMAIL_HOST_PASSWORD in the keychain, not here).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=orders@example.com
# EMAIL_USE_TLS=True
# Cloudflare Turnstile captcha. Unset = disabled. Pair with the frontend's
# VITE_TURNSTILE_SITE_KEY; put the secret in the keychain.
# TURNSTILE_SECRET_KEY=
# Yard time zone for delivery dates, e.g. America/Denver.
# TIME_ZONE=UTC
# Zip-code lookup table; blank = apps/intake/data/service_area.json.
# SERVICE_AREA_FILE=/srv/config/service_area.json
