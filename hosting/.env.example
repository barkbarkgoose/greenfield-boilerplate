# Deploy target for hosting/provision.sh, deploy.sh and deploy-rsync.sh.
# Copy to hosting/.env (gitignored), or just run ./hosting/provision.sh: it asks for anything
# missing and saves the answers there. For a second target (staging, a test VM), keep another
# file such as hosting/.env.staging and pass --env hosting/.env.staging to each script.
#
# The project's own settings (folders, test/build commands, health and auth paths) are at the
# top of hosting/provision.sh; the Python version is in backend/.python-version and the Node
# major in "engines" in frontend/package.json.

DEPLOY_HOST=droplet                        # ssh alias from ~/.ssh/config
DEPLOY_NAME=myapp                          # service user, /srv/NAME, systemd unit, nginx site, Postgres role and database
DEPLOY_DOMAIN=app.example.com              # its DNS A record must point at the server for HTTPS
DEPLOY_EMAIL=you@example.com               # Let's Encrypt expiry notices
DEPLOY_DB=postgres                         # postgres (on the server) | external (DATABASE_URL in /srv/NAME/.env)
DEPLOY_REPO=git@github.com:owner/repo.git  # the server fetches from here; none = deploy from the Mac with deploy-rsync.sh
DEPLOY_BRANCH=main                         # deployed when ./hosting/deploy.sh gets no ref

# Optional (defaults shown)
# DEPLOY_PORT=8000                         # gunicorn on 127.0.0.1; default: first free port from 8000
# DEPLOY_WORKERS=2                         # gunicorn worker processes
# DEPLOY_THREADS=2                         # threads per worker
# DEPLOY_MAX_BODY=1m                       # largest request nginx accepts (raise for uploads)
# DEPLOY_BUILD_MEMORY_MAX=250M             # RAM for tests and the build on the server before they swap
# DEPLOY_BUILD_SWAP_MAX=1G                 # swap they may use before they are killed
